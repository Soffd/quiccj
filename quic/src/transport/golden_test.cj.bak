package quic.transport

import quic.crypto.*
import std.unittest.*
import std.unittest.testmacro.*
import std.fs.*

/*
 * Byte-exact verification against the RFC 9001 Appendix A sample packets.
 * These vectors exercise the whole packet layer: header layout, AEAD,
 * header protection sampling and packet number encoding.
 */

@Test
class GoldenPacketTest {
    static func readHex(path: String): Array<UInt8> {
        let f = File(path, OpenMode.Read)
        let buf = Array<UInt8>(8192, repeat: 0)
        let n = f.read(buf)
        f.close()
        let raw = sliceBytes(buf, 0, n)
        var count = 0
        var i = 0
        while (i < raw.size) {
            let c = raw[i]
            if ((c >= 48 && c <= 57) || (c >= 97 && c <= 102) || (c >= 65 && c <= 70)) {
                count++
            }
            i++
        }
        let digits = Array<UInt8>(count, repeat: 0)
        var k = 0
        i = 0
        while (i < raw.size) {
            let c = raw[i]
            if ((c >= 48 && c <= 57) || (c >= 97 && c <= 102) || (c >= 65 && c <= 70)) {
                digits[k] = c
                k++
            }
            i++
        }
        return hexDecode(String.fromUtf8(digits))
    }

    static func firstDiff(a: Array<UInt8>, b: Array<UInt8>): Int64 {
        var i = 0
        while (i < a.size && i < b.size) {
            if (a[i] != b[i]) {
                return i
            }
            i++
        }
        if (a.size != b.size) {
            return i
        }
        return -1
    }

    @TestCase
    func clientInitialDecrypts() {
        let pkt = readHex("testdata/rfc9001_a2_packet.hex")
        @Expect(pkt.size, 1200)
        let (c, _) = PacketCrypto.initialSecrets(hexDecode("8394c8f03e515708"))
        \/\/ RFC 9001 A.2 published the header protection mask for this packet
        let mask = HeaderProtection.mask(c.hp, sliceBytes(pkt, 22, 16))
        @Expect(hexEncode(sliceBytes(mask, 0, 5)), "437b9aec36")

        let p = PacketBuilder.openLong(pkt, c)
        @Expect(p.longHeader, true)
        @Expect(p.typeBits, 0)
        @Expect(p.version, QUIC_V1)
        @Expect(hexEncode(p.dcid), "8394c8f03e515708")
        @Expect(p.scid.size, 0)
        @Expect(p.pnLen, 4)
        @Expect(p.pn, 2)
        @Expect(hexEncode(p.header), "c000000001088394c8f03e5157080000449e00000002")

        let expectPay = readHex("testdata/rfc9001_a2_payload.hex")
        @Expect(p.payload.size, 1162)
        let head = sliceBytes(p.payload, 0, expectPay.size)
        @Expect(hexEncode(head), hexEncode(expectPay))
        \/\/ CRYPTO frame: type 0x06, offset 0, length 0xf1 (241 byte ClientHello)
        @Expect(head[0], 0x06)
        @Expect(beU16(head, 2) & 0x3FFF, 0xf1)
        @Expect(String.fromUtf8(sliceBytes(head, 4 + 4 + 2 + 32 + 1, 18)), "example.com")
        var padNonZero = 0
        var i = expectPay.size
        while (i < p.payload.size) {
            if (p.payload[i] != 0) {
                padNonZero++
            }
            i++
        }
        @Expect(padNonZero, 0)
    }

    @TestCase
    func clientInitialReencodes() {
        let expected = readHex("testdata/rfc9001_a2_packet.hex")
        let payload = readHex("testdata/rfc9001_a2_payload.hex")
        let (c, _) = PacketCrypto.initialSecrets(hexDecode("8394c8f03e515708"))
        let built = PacketBuilder.longHeader(0, hexDecode("8394c8f03e515708"),
            Array<UInt8>(0, repeat: 0), Array<UInt8>(0, repeat: 0), 2, 4, c, payload, 1200)
        @Expect(built.size, 1200)
        let d = firstDiff(built, expected)
        @Expect(d, -1)
        @Expect(hexEncode(built), hexEncode(expected))
    }

    @TestCase
    func serverInitialDecrypts() {
        let pkt = readHex("testdata/rfc9001_a3_packet.hex")
        @Expect(pkt.size, 135)
        let (_, s) = PacketCrypto.initialSecrets(hexDecode("8394c8f03e515708"))
        let p = PacketBuilder.openLong(pkt, s)
        @Expect(p.typeBits, 0)
        @Expect(p.dcid.size, 0)
        @Expect(hexEncode(p.scid), "f067a5502a4262b5")
        @Expect(p.pnLen, 2)
        @Expect(p.pn, 1)
        let expectPay = readHex("testdata/rfc9001_a3_payload.hex")
        @Expect(hexEncode(p.payload), hexEncode(expectPay))
        @Expect(p.payload[0], 0x02)
        @Expect(p.payload[8], 0x06)
    }
}
